{
  "name": "pl_cre_end_to_end",
  "purpose": "Logical implementation manifest for a Microsoft Fabric Data Pipeline",
  "library_variables": {
    "library": "vl_cre_settings",
    "variables": {
      "environment": {"type": "String", "default": "dev"},
      "workspace": {"type": "String", "default": "ws-cre-modernization-dev workspace ID"},
      "semantic-model": {"type": "String", "default": "CRE Portfolio Analytics model ID in ws-cre-modernization-dev"}
    }
  },
  "activities": [
    {
      "name": "nb_cre_bronze_ingest",
      "type": "Notebook",
      "notebook": "notebooks/nb_cre_bronze_ingest.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [],
      "base_parameters": {"pipeline_run_id": "@pipeline().RunId"},
      "retry": 1,
      "retry_interval_seconds": 120,
      "session_tag": "cre_pipeline",
      "timeout_minutes": 30
    },
    {
      "name": "nb_cre_silver_transform",
      "type": "Notebook",
      "notebook": "notebooks/nb_cre_silver_transform.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [{"activity": "nb_cre_bronze_ingest", "conditions": ["Succeeded"]}],
      "retry": 1,
      "retry_interval_seconds": 120,
      "session_tag": "cre_pipeline",
      "timeout_minutes": 45
    },
    {
      "name": "nb_cre_gold_build_model",
      "type": "Notebook",
      "notebook": "notebooks/nb_cre_gold_build_model.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [{"activity": "nb_cre_silver_transform", "conditions": ["Succeeded"]}],
      "retry": 1,
      "retry_interval_seconds": 120,
      "session_tag": "cre_pipeline",
      "timeout_minutes": 45
    },
    {
      "name": "nb_cre_gold_validate_model",
      "type": "Notebook",
      "notebook": "notebooks/nb_cre_gold_validate_model.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [{"activity": "nb_cre_gold_build_model", "conditions": ["Succeeded"]}],
      "retry": 1,
      "retry_interval_seconds": 120,
      "session_tag": "cre_pipeline",
      "timeout_minutes": 15
    },
    {
      "name": "refresh_semantic_model",
      "type": "SemanticModelRefresh",
      "semantic_model": "CRE Portfolio Analytics",
      "connection": "conn_cre_semantic_model",
      "workspace_id": "@pipeline().libraryVariables.workspace",
      "semantic_model_id": "@pipeline().libraryVariables['semantic-model']",
      "depends_on": [{"activity": "nb_cre_gold_validate_model", "conditions": ["Succeeded"]}],
      "retry": 1,
      "retry_interval_seconds": 120,
      "timeout_minutes": 15
    },
    {
      "name": "log_run_succeeded",
      "type": "Notebook",
      "notebook": "notebooks/nb_cre_gold_log_pipeline_run.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [{"activity": "refresh_semantic_model", "conditions": ["Succeeded"]}],
      "base_parameters": {
        "pipeline_run_id": "@pipeline().RunId",
        "pipeline_name": "@pipeline().Pipeline",
        "environment": "@pipeline().libraryVariables.environment",
        "status": "Succeeded",
        "triggered_at": "@string(pipeline().TriggerTime)"
      },
      "retry": 1,
      "retry_interval_seconds": 120,
      "session_tag": "cre_pipeline",
      "timeout_minutes": 10
    },
    {
      "name": "log_run_failed",
      "type": "Notebook",
      "notebook": "notebooks/nb_cre_gold_log_pipeline_run.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [{"activity": "refresh_semantic_model", "conditions": ["Failed", "Skipped"]}],
      "base_parameters": {
        "pipeline_run_id": "@pipeline().RunId",
        "pipeline_name": "@pipeline().Pipeline",
        "environment": "@pipeline().libraryVariables.environment",
        "status": "Failed",
        "triggered_at": "@string(pipeline().TriggerTime)",
        "message": "One or more activities failed or were skipped; see this run in the Monitor hub."
      },
      "retry": 1,
      "retry_interval_seconds": 120,
      "session_tag": "cre_pipeline",
      "timeout_minutes": 10
    }
  ]
}
