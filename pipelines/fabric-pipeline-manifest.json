{
  "name": "pl_cre_end_to_end",
  "purpose": "Logical implementation manifest for a Microsoft Fabric Data Pipeline",
  "parameters": ["environment", "pipeline_run_id"],
  "activities": [
    {
      "name": "nb_cre_bronze_ingest",
      "type": "Notebook",
      "notebook": "notebooks/fabric/nb_cre_bronze_ingest.py",
      "default_lakehouse": "lh_cre_bronze",
      "depends_on": [],
      "retry": 1,
      "timeout_minutes": 30
    },
    {
      "name": "nb_cre_silver_transform",
      "type": "Notebook",
      "notebook": "notebooks/fabric/nb_cre_silver_transform.py",
      "default_lakehouse": "lh_cre_silver",
      "depends_on": ["nb_cre_bronze_ingest"],
      "dependency_condition": "Succeeded",
      "retry": 0,
      "timeout_minutes": 45
    },
    {
      "name": "nb_cre_gold_build_model",
      "type": "Notebook",
      "notebook": "notebooks/fabric/nb_cre_gold_build_model.py",
      "default_lakehouse": "lh_cre_gold",
      "depends_on": ["nb_cre_silver_transform"],
      "dependency_condition": "Succeeded",
      "retry": 0,
      "timeout_minutes": 45
    },
    {
      "name": "nb_cre_gold_validate_model",
      "type": "Notebook",
      "notebook": "notebooks/fabric/nb_cre_gold_validate_model.py",
      "default_lakehouse": "lh_cre_gold",
      "depends_on": ["nb_cre_gold_build_model"],
      "dependency_condition": "Succeeded",
      "retry": 0,
      "timeout_minutes": 15
    },
    {
      "name": "log_pipeline_failure",
      "type": "StoredProcedureOrNotebook",
      "depends_on": ["nb_cre_bronze_ingest", "nb_cre_silver_transform", "nb_cre_gold_build_model", "nb_cre_gold_validate_model"],
      "dependency_condition": "FailedOrSkipped"
    }
  ]
}
